# API auth
API_KEY=changeme

# Paths to the compiled engine binary + GGUF weights inside the container
# (already correct for the provided Dockerfile — only change if you mount
# your own build/model directory instead).
ASR_SERVER_BIN=/app/bin/asr_stream_server
VAE_MODEL_PATH=/app/models/vibeasr-vae-encoder-i8_s.gguf
LM_MODEL_PATH=/app/models/vibeasr-lm-i2_s-embed-q6_k.gguf

# Inference engine settings
ASR_THREADS=4
ASR_MAX_TOKENS=4096
ASR_PROMPT_FORMAT=text
ASR_GREEDY=true
ASR_TEMPERATURE=0.7
ASR_TOP_P=0.9
ASR_CONTEXT=
ASR_STARTUP_TIMEOUT=120

# Upload limits
MAX_UPLOAD_BYTES=209715200
